# ===== Postgres (superusuário admin, usado só para inicializar o cluster) =====
POSTGRES_ADMIN_PASSWORD='Postgres_Admin_Demo_2026!'

# ===== Databases por API (criados pelo init-db/01-create-databases.sh) =====
USERS_DB_NAME=fcg_users_demo
USERS_DB_USER=fcg_users_demo
USERS_DB_PASSWORD='UsersDb_Demo_2026!'

CATALOG_DB_NAME=fcg_catalog_demo
CATALOG_DB_USER=fcg_catalog_demo
CATALOG_DB_PASSWORD='CatalogDb_Demo_2026!'

PAYMENTS_DB_NAME=fcg_payments_demo
PAYMENTS_DB_USER=fcg_payments_demo
PAYMENTS_DB_PASSWORD='PaymentsDb_Demo_2026!'

NOTIFICATIONS_DB_NAME=fcg_notifications_demo
NOTIFICATIONS_DB_USER=fcg_notifications_demo
NOTIFICATIONS_DB_PASSWORD='NotificationsDb_Demo_2026!'

# ===== RabbitMQ =====
RABBITMQ_USER=fcg_demo
RABBITMQ_PASSWORD='Rabbit_Demo_2026!'

# ===== Portas expostas no host (127.0.0.1) =====
FCG_RABBIT_MANAGEMENT_PORT=15672
FCG_USERS_HTTP_PORT=5088
FCG_CATALOG_HTTP_PORT=5081
FCG_PAYMENTS_HTTP_PORT=5082
FCG_API4_HTTP_PORT=5083

# Imagens das APIs.
USERS_IMAGE=fgcprojetofiap/users-api:1.4
CATALOG_IMAGE=fgcprojetofiap/catalog-api:1.0.2
PAYMENTS_IMAGE=fgcprojetofiap/payments-api:1.2
NOTIFICATIONS_IMAGE=fgcprojetofiap/notifications-api:1.0.2
